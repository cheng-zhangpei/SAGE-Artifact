      },
      "description": "读取仅含ACCESS的材料并追加到 slot:case。"
    },
    {
      "agent": "onboarding",
      "tool": "receive_record",
      "params": {
        "category": "UNSCREENED"
      },
      "description": "读取仅含UNSCREENED的材料并追加到 slot:case。"
    },
    {
      "agent": "analyst",
      "tool": "verify_case",
      "params": {},
      "description": "将 case 追加到 verified。"
    },
    {
      "agent": "coordinator",
      "tool": "bundle_case",
      "params": {
        "source": "verified"
      },
      "description": "将 verified 追加到 package。"
    },
    {
      "agent": "coordinator",
      "tool": "bundle_case",
      "params": {
        "source": "case"
      },
      "description": "将 case 直接追加到 package。"
    },
