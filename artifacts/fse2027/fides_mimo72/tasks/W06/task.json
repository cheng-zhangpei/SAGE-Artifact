{
  "id": "W06",
  "layer": "base",
  "public": {
    "description": "# 差旅申请与支付卡附件\n\n员工差旅包可以分别加入证件资料和公司卡资料。授权旅行社需要证件，但不允许接收公司卡资料；公司内财务系统允许两者。公开协作看板不允许任何一种。所谓简版申请只是读取另一份公开行程，不会净化已有差旅包。\n\n初始资料：slot:passport 含 PII；slot:card 含 PCI。其他位置初始不含受限标签。\n本任务所有工具只读取各自文字描述列出的数据，不隐式读取调用者上下文。各位置保留此前内容，写入为追加；读取和全部副写入在同一次原子调用内完成。没有未说明的净化、认证或解密。工具可重复调用，调用顺序不限。请为整个工作流而不是某一条示例路径起草 guard；既要阻断禁止流，也要保留未违反策略的调用。未列在 B(v) 中的位置不禁止任何标签。",
    "labels": {
      "PII": "护照及旅客身份",
      "PCI": "支付卡资料"
    },
    "tools": [
      {
        "agent": "assistant",
        "tool": "attach",
        "params": {
          "document": "passport"
        },
        "description": "把护照资料追加到差旅申请 slot:request。"
      },
      {
        "agent": "finance",
        "tool": "attach",
        "params": {
          "document": "card"
        },
        "description": "把公司卡资料追加到差旅申请 slot:request。"
      },
      {
        "agent": "travel",
        "tool": "submit",
        "params": {
          "source": "request",
          "target": "agency"
        },
        "description": "将完整申请及全部附件发送到授权旅行社 slot:agency。"
      },
      {
        "agent": "travel",
        "tool": "submit",
        "params": {
          "source": "request",
          "target": "finance"
        },
        "description": "将完整申请及全部附件交给内部财务 slot:finance。"
      },
      {
        "agent": "travel",
        "tool": "submit",
        "params": {
          "source": "request",
          "target": "board"
        },
        "description": "将完整申请及全部附件放到公开协作看板 slot:board。"
      },
      {
        "agent": "travel",
        "tool": "submit",
        "params": {
          "source": "itinerary",
          "target": "board"
        },
        "description": "只读取公开行程 slot:itinerary 并发布到看板，不读取申请附件。"
      }
    ],
    "policy": {
      "slot:agency": [
        "PCI"
      ],
      "slot:board": [
        "PII",
        "PCI"
      ]
    }
  },
