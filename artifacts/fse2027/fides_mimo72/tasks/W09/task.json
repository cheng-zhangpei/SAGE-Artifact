  "public": {
    "description": "# 采购报价与自动下单\n\n采购团队把供应商网页和内部底价加入共享评估。外部网页未经核验，内部底价属于商务机密。生产采购单不能受未经核验内容影响；供应商回复不能包含内部底价。内部评审区允许两者，给供应商转发其公开网页本身不违反此策略。\n\n初始资料：slot:web 含 UNVERIFIED；slot:floor 含 CONFIDENTIAL。其他位置初始不含受限标签。\n本任务所有工具只读取各自文字描述列出的数据，不隐式读取调用者上下文。各位置保留此前内容，写入为追加；读取和全部副写入在同一次原子调用内完成。没有未说明的净化、认证或解密。工具可重复调用，调用顺序不限。请为整个工作流而不是某一条示例路径起草 guard；既要阻断禁止流，也要保留未违反策略的调用。未列在 B(v) 中的位置不禁止任何标签。",
    "labels": {
      "UNVERIFIED": "未核验供应商内容",
      "CONFIDENTIAL": "内部采购底价"
    },
    "tools": [
      {
        "agent": "researcher",
        "tool": "collect",
        "params": {
          "source": "web"
        },
        "description": "将未经核验的供应商网页内容追加到共享评估 slot:assessment；摘要不会构成核验。"
      },
      {
        "agent": "buyer",
        "tool": "collect",
        "params": {
          "source": "floor"
        },
        "description": "将内部采购底价追加到共享评估 slot:assessment。"
      },
      {
        "agent": "buyer",
        "tool": "submit",
        "params": {
          "target": "order"
        },
        "description": "使用完整评估内容生成并写入生产采购单 slot:order。"
      },
      {
        "agent": "buyer",
        "tool": "submit",
        "params": {
          "target": "supplier"
        },
        "description": "把完整评估内容发送到供应商回复 slot:supplier。"
      },
      {
        "agent": "buyer",
        "tool": "submit",
        "params": {
          "target": "review"
        },
        "description": "把完整评估放入受信内部评审区 slot:review；此工具本身不核验也不去除任何标签。"
      },
      {
        "agent": "buyer",
        "tool": "submit",
        "params": {
          "target": "order_and_supplier"
        },
        "description": "把完整评估同时用于生产采购单并发送给供应商。"
      }
    ],
    "policy": {
      "slot:order": [
        "UNVERIFIED"
      ],
      "slot:supplier": [
        "CONFIDENTIAL"
      ]
    }
  },
