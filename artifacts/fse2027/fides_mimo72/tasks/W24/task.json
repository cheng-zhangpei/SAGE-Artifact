  "public": {
    "description": "# 公益救助名册与募捐材料\n\n社工把受助人身份和困难说明汇集为个案包。救助委员会允许两者，配送商只允许身份，公开募捐页不允许两者。include_case会把完整个案包与公开封面合并，封面不是脱敏操作。\n\n初始资料：slot:person 含 PII；slot:details 含 HARDSHIP。其他位置初始不含受限标签。\n本任务所有工具只读取各自文字描述列出的数据，不隐式读取调用者上下文。各位置保留此前内容，写入为追加；读取和全部副写入在同一次原子调用内完成。没有未说明的净化、认证或解密。工具可重复调用，调用顺序不限。请为整个工作流而不是某一条示例路径起草 guard；既要阻断禁止流，也要保留未违反策略的调用。未列在 B(v) 中的位置不禁止任何标签。",
    "labels": {
      "PII": "受助人身份",
      "HARDSHIP": "家庭困难信息"
    },
    "tools": [
      {
        "agent": "social_worker",
        "tool": "collect",
        "params": {
          "part": "person"
        },
        "description": "将身份追加个案包。"
      },
      {
        "agent": "reviewer",
        "tool": "collect",
        "params": {
          "part": "details"
        },
        "description": "将困难说明追加个案包。"
      },
      {
        "agent": "coordinator",
        "tool": "send",
        "params": {
          "target": "committee"
        },
        "description": "将完整个案包交给授权委员会。"
      },
      {
        "agent": "coordinator",
        "tool": "send",
        "params": {
          "target": "delivery"
        },
        "description": "将完整个案包发配送商。"
      },
      {
        "agent": "campaign",
        "tool": "publish",
        "params": {
          "include_case": false
        },
        "description": "只读取公开封面并发布募捐页。"
      },
      {
        "agent": "campaign",
        "tool": "publish",
        "params": {
          "include_case": true
        },
        "description": "读取封面与完整个案包并发布募捐页。"
      }
    ],
    "policy": {
      "slot:delivery": [
        "HARDSHIP"
      ],
      "slot:fundraising": [
        "PII",
        "HARDSHIP"
      ]
    }
  },
