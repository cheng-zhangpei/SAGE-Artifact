  "public": {
    "description": "# 法务摘要的共享笔记和第二发布路径\n\n法务助理把受保密协议约束的谈判材料整理为共享笔记，编辑 Agent 可以转存到待发布区。摘要仍属于保密材料，不存在自动解密。授权律师门户可接收，网站和公开订阅邮件不可接收。直接邮件与网站发布是两条独立出口。\n\n初始资料：slot:negotiation 含 CONFIDENTIAL。其他位置初始不含受限标签。\n本任务所有工具只读取各自文字描述列出的数据，不隐式读取调用者上下文。各位置保留此前内容，写入为追加；读取和全部副写入在同一次原子调用内完成。没有未说明的净化、认证或解密。工具可重复调用，调用顺序不限。请为整个工作流而不是某一条示例路径起草 guard；既要阻断禁止流，也要保留未违反策略的调用。未列在 B(v) 中的位置不禁止任何标签。",
    "labels": {
      "CONFIDENTIAL": "受保密协议约束的材料"
    },
    "tools": [
      {
        "agent": "legal",
        "tool": "summarize",
        "params": {},
        "description": "将谈判摘要追加到共享笔记 slot:notes；摘要保留原材料的保密属性。"
      },
      {
        "agent": "editor",
        "tool": "stage",
        "params": {},
        "description": "将共享笔记复制到待发布区 slot:staged。"
      },
      {
        "agent": "publisher",
        "tool": "publish",
        "params": {
          "source": "staged",
          "target": "website"
        },
        "description": "读取待发布区并公开发布到网站 slot:website。"
      },
      {
        "agent": "publisher",
        "tool": "publish",
        "params": {
          "source": "notes",
          "target": "newsletter"
        },
        "description": "直接读取共享笔记并发往公开订阅邮件 slot:newsletter；无需经过待发布区。"
      },
      {
        "agent": "publisher",
        "tool": "publish",
        "params": {
          "source": "notes",
          "target": "counsel"
        },
        "description": "将共享笔记发送到授权律师门户 slot:counsel。"
      },
      {
        "agent": "publisher",
        "tool": "publish",
        "params": {
          "source": "template",
          "target": "website"
        },
        "description": "只读取公开模板 slot:template 并发布到网站；不会访问笔记和待发布区。"
      }
    ],
    "policy": {
      "slot:website": [
