        "params": {
          "target": "listing"
        },
        "description": "将整个看房包发布到公开房源页。"
      },
      {
        "agent": "broker",
        "tool": "send",
        "params": {
          "target": "sms"
        },
        "description": "将整个看房包发送到短信商。"
      },
      {
        "agent": "broker",
        "tool": "send",
        "params": {
          "target": "private"
        },
        "description": "将整个看房包发送到授权私人带看系统。"
