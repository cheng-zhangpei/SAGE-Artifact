        "params": {
          "to": "archive",
          "scope": "all"
        },
        "description": "合并两份提案写内部档案。"
      }
    ],
    "policy": {
      "slot:out_a": [
        "CLIENT_B"
      ],
      "slot:out_b": [
        "CLIENT_A"
      ]
    }
